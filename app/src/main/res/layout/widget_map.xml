<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" />
  <ImageView android:id="@+id/gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
  <ImageView android:id="@+id/rim" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/glass_rim" android:scaleType="fitXY" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <!-- Tầng 1: lời chào + châm ngôn (trái) · giờ lớn (phải) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/greet" android:layout_width="match_parent" android:layout_height="19dp" android:textSize="13sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/quote_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="1dp">
          <ImageView android:id="@+id/quote_icon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="3dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_quote" />
          <TextView android:id="@+id/quote" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:textSize="10.5sp" android:textStyle="bold|italic" android:textColor="#FFFFFF" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7.5sp" android:autoSizeMaxTextSize="10.5sp" android:autoSizeStepGranularity="0.5sp" android:lineSpacingMultiplier="0.95" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
        </LinearLayout>
      </LinearLayout>
      <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="h:mm" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true" android:layout_marginStart="10dp" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
      <TextView android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginStart="2dp"/>
    </LinearLayout>

    <!-- Tầng 2: ngày (trái) + bản đồ (phải) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="6dp">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:id="@+id/big3d" android:layout_width="74dp" android:layout_height="62dp" android:scaleType="fitCenter" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/d_weekday" android:layout_width="match_parent" android:layout_height="23dp" android:textSize="16sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold"/>
            <TextView android:id="@+id/d_month" android:layout_width="match_parent" android:layout_height="19dp" android:textSize="12sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium" android:layout_marginTop="1dp"/>
            <TextView android:id="@+id/d_lunar" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="1dp"/>
          </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/rem1" android:layout_width="match_parent" android:layout_height="17dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/rem2" android:layout_width="match_parent" android:layout_height="17dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="1dp"/>
        <TextView android:id="@+id/tuoi" android:layout_width="match_parent" android:layout_height="17dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="1dp"/>
      </LinearLayout>
      <LinearLayout android:layout_width="86dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
        <ImageView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" />
        <TextView android:id="@+id/place" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="12sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:gravity="center" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/prov" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:gravity="center"/>
      </LinearLayout>
    </LinearLayout>

    <!-- Tầng 3: thanh thời tiết (chạm để cập nhật) -->
    <RelativeLayout android:id="@+id/wx_col" android:layout_width="match_parent" android:layout_height="wrap_content">
      <ImageView android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignTop="@+id/wx_row" android:layout_alignBottom="@+id/wx_row" android:src="@drawable/panel_bg" android:scaleType="fitXY" />
      <LinearLayout android:id="@+id/wx_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <ImageView android:id="@+id/wx_icon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/wxv_partly_day" />
        <TextView android:id="@+id/wx_temp" android:layout_width="52dp" android:layout_height="32dp" android:textSize="24sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium" android:layout_marginStart="2dp"/>
        <LinearLayout android:layout_width="86dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="4dp">
          <TextView android:id="@+id/wx_desc" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold"/>
          <TextView android:id="@+id/wx_hilo" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
          <TextView android:id="@+id/rain" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginStart="4dp">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/f0_lb" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:gravity="center"/>
            <ImageView android:id="@+id/f0_ic" android:layout_width="18dp" android:layout_height="18dp" />
            <TextView android:id="@+id/f0_t" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:gravity="center"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/f1_lb" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:gravity="center"/>
            <ImageView android:id="@+id/f1_ic" android:layout_width="18dp" android:layout_height="18dp" />
            <TextView android:id="@+id/f1_t" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:gravity="center"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/f2_lb" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:gravity="center"/>
            <ImageView android:id="@+id/f2_ic" android:layout_width="18dp" android:layout_height="18dp" />
            <TextView android:id="@+id/f2_t" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="11sp" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="0.5sp" android:maxLines="1" android:includeFontPadding="true" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:gravity="center"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </RelativeLayout>
  </LinearLayout>
</FrameLayout>
