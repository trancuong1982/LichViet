<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" />
  <ImageView android:id="@+id/gloss" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
  <ImageView android:id="@+id/rim" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/glass_rim" android:scaleType="fitXY" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <!-- Dòng đầu: lời chào (đủ chữ) + tháng/năm -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/greet" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_weight="1"/>
      <TextView android:id="@+id/d_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="3dp">
      <LinearLayout android:id="@+id/wx_col" android:layout_width="0dp" android:layout_weight="1.15" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:id="@+id/wx_icon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/wx_partly_day" />
          <TextView android:id="@+id/wx_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium" android:layout_marginStart="3dp"/>
        </LinearLayout>
        <TextView android:id="@+id/wx_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/wx_hilo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="3dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
          <TextView android:id="@+id/wx_place" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_weight="1"/>
          <FrameLayout android:id="@+id/btn_refresh" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="2dp">
            <ImageView android:id="@+id/rf_bg" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/circle_bg" />
            <ImageView android:id="@+id/rf_icon" android:layout_width="26dp" android:layout_height="26dp" android:padding="6dp" android:src="@drawable/wx_refresh" />
          </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/rain_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
          <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/wx_umbrella_small" />
          <TextView android:id="@+id/rain" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginStart="3dp" android:layout_weight="1"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="0.95" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginStart="4dp">
        <ImageView android:id="@+id/big3d" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" />
        <TextView android:id="@+id/d_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/d_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="3dp"/>
      </LinearLayout>
      <ImageView android:id="@+id/cal" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="match_parent" android:scaleType="fitCenter" android:layout_marginStart="6dp" />
    </LinearLayout>
    <ImageView android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/chip_bg" android:scaleType="fitXY" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/ev_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:letterSpacing="0.08" android:text="SỰ KIỆN &amp; NGÀY LỄ"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/ev0_d" android:layout_width="54dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
        <TextView android:id="@+id/ev0_t" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/ev1_d" android:layout_width="54dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
        <TextView android:id="@+id/ev1_t" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/ev2_d" android:layout_width="54dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
        <TextView android:id="@+id/ev2_t" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/tuoi_col" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/t_head" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:letterSpacing="0.08" android:layout_weight="1"/>
          <TextView android:id="@+id/t_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:letterSpacing="0.1"/>
        </LinearLayout>
        <TextView android:id="@+id/t_muc" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:textStyle="bold" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/t_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/t_gio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="2dp"/>
      </LinearLayout>
    </LinearLayout>
    <RelativeLayout android:id="@+id/quote_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
      <ImageView android:id="@+id/quote_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@+id/quote_in" android:layout_alignBottom="@+id/quote_in" android:layout_alignStart="@+id/quote_in" android:layout_alignEnd="@+id/quote_in" android:src="@drawable/quote_bg" android:scaleType="fitXY" />
      <LinearLayout android:id="@+id/quote_in" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="9dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/quote_icon" android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_quote" />
        <TextView android:id="@+id/quote" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold|italic" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" />
      </LinearLayout>
    </RelativeLayout>
  </LinearLayout>
</FrameLayout>
