<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
<LinearLayout android:layout_width="84dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
  <TextView android:id="@+id/d_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium"/>
  <TextView android:id="@+id/d_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="50sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
  <TextView android:id="@+id/d_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="2dp"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
    <RelativeLayout android:id="@+id/week_box" android:layout_width="wrap_content" android:layout_height="wrap_content" >
  <ImageView android:id="@+id/week_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@+id/week" android:layout_alignBottom="@+id/week" android:layout_alignStart="@+id/week" android:layout_alignEnd="@+id/week" android:src="@drawable/chip_bg" android:scaleType="fitXY" />
  <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1F3A80" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:includeFontPadding="false" />
</RelativeLayout>
    <RelativeLayout android:id="@+id/lchip_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp">
  <ImageView android:id="@+id/lchip_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@+id/lchip" android:layout_alignBottom="@+id/lchip" android:layout_alignStart="@+id/lchip" android:layout_alignEnd="@+id/lchip" android:src="@drawable/chip_bg" android:scaleType="fitXY" />
  <TextView android:id="@+id/lchip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1F3A80" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:includeFontPadding="false" />
</RelativeLayout>
  </LinearLayout>
  <TextView android:id="@+id/d_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="7dp"/>
  <TextView android:id="@+id/d_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="4dp"/>
  <TextView android:id="@+id/d_l3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="4dp" android:fontFamily="sans-serif-medium"/>
  <TextView android:id="@+id/d_l4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1B1F2A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="2" android:shadowDy="1" android:layout_marginTop="4dp"/>
</LinearLayout>
